# Application Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication
JWT_SECRET=super-secret-coffee-ninja-jwt-key-2026-change-in-prod
JWT_EXPIRES_IN=24h

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=customer_inquiries

# Or full database connection URL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/customer_inquiries
